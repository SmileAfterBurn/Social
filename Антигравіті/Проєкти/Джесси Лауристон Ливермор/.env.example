# JESSIE 3.0 — Environment Variables Template
# Copy to .env and fill in your values:
#   cp .env.example .env

# ── API Keys ──────────────────────────────────────────────────────────────────
CMC_KEY=
CRYPTOPANIC_KEY=
GOOGLE_API_KEY=
HF_TOKEN=

# ── Binance ───────────────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
# Ed25519 auth (optional, leave empty for HMAC)
BINANCE_PRIVATE_KEY_PATH=
BINANCE_PUBLIC_KEY_PATH=

# ── Account Parameters ────────────────────────────────────────────────────────
BALANCE=20.0
LEVERAGE=10
MAX_DAILY_LOSS_PCT=30
MAX_COIN_PRICE=1.0

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Voice / Memory / Dataset ─────────────────────────────────────────────────
VOICE_ENABLED=false
WHISPER_MODEL=base
TTS_VOICE=uk-UA-PolinaNeural
MEMORY_SIZE=20
DUMP_PATH=./dump/outline
FEEDBACK_MIN_PNL=5.0

# ── AI Workflow Skills (optional) ─────────────────────────────────────────────
# Path to ai-workflow skills directory
SKILLS_DIR=

# ── CORS (optional) ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8001,http://localhost:3000,http://localhost:19006
